# === Telegram (опционально — для web-only оставьте пустым) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false
TELEGRAM_OWNER_CHAT_ID=279887118
# Опционально — если api.telegram.org заблокирован и нужно ходить через прокси:
# TELEGRAM_PROXY_URL=socks5://user:pass@host:1080
# TELEGRAM_PROXY_URL=http://user:pass@host:3128
TELEGRAM_PROXY_URL=

# === Database (SQLite, локальный файл) ===
# На Windows можно указать абсолютный путь вида C:/Users/<user>/vp_state.db
SQLITE_PATH=./data/state.db

# Browser (Playwright к твоему Chrome через CDP) ===
# Запуск: Start-Chrome.cmd  (профиль = логины ChatGPT/outsee)
# Перенос с другого ПК: Restore-Chrome-Profile.cmd
BROWSER_CDP_URL=http://localhost:29229
# Профиль Chrome (по умолчанию %USERPROFILE%\.vp_browser_data):
# BROWSER_USER_DATA_DIR=C:\Users\Love Space\.vp_browser_data

# === outsee.io ===
OUTSEE_IMAGE_URL=https://outsee.io/image?model=gpt-image-2
OUTSEE_VIDEO_URL=https://outsee.io/video?model=veo-3-fast
# true = одна очередь Outsee (картинки+видео), без галереи по [ID: …]
OUTSEE_QUEUE_MODE=true
# Developer API (Bearer) — ключ из https://outsee.io/profile (НЕ Grsai, НЕ cookies)
OUTSEE_API_KEY=
OUTSEE_API_BASE_URL=https://outsee.io
OUTSEE_DEFAULT_IMAGE_MODEL=gpt-image-2
OUTSEE_DEFAULT_VIDEO_MODEL=veo-3-1-lite
# при сбое API — откат на Playwright UI (нужен Chrome CDP)
OUTSEE_HTTP_FALLBACK_CDP=true
# Сколько Create-генераций идут в API одновременно (остальные ждут в очереди)
CREATE_MAX_PARALLEL=5
CREATE_MAX_PARALLEL_OUTSEE=4

# outsee | kie — кто рисует img/hero/items (outsee → OUTSEE_API_KEY)
IMAGE_PROVIDER=outsee
# outsee | kie — Create / пайплайн video
VIDEO_PROVIDER=outsee

# === Текстовый LLM (excel_gpt / check / workspace) — НЕ картинки/видео ===
#
# GPT (kie) — основной, по умолчанию. Kimi K3 — ДОПОЛНИТЕЛЬНАЯ модель
# с https://www.tokenrouter.com (выбор в Studio / data/text_llm_choice.json).
#
# TEXT_LLM_PROVIDER=kie          # default = GPT
# TEXT_LLM_PROVIDER=tokenrouter  # принудительно Kimi (обычно не нужно — есть UI)
#
TEXT_LLM_PROVIDER=kie

# --- GPT / kie + vibecode: только через VPS-relay, прокси на ПК не нужен ---
# Деплой: deploy/gpt-relay/README.md  →  docker compose up -d
# kie:     https://<VPS>/codex/v1/responses
# vibecode:https://<VPS>/v1/chat/completions  (модели с ноды / шапки)
GPT_API_KEY=
GPT_BASE_URL=https://gpt.example.com
GPT_RELAY_TOKEN=
GPT_PROXY_URL=
GPT_MODEL=gpt-5-6-sol
GPT_CHAT_PATH=/codex/v1/responses
GPT_API_MODE=auto
GPT_TIMEOUT_S=600
GPT_MAX_RETRIES=4
# Прямой api.kie.ai — только если VPS ещё нет (не рекомендуется):
# GPT_BASE_URL=https://api.kie.ai

# --- Kie Market / вкладка «Генерация» — ОТДЕЛЬНЫЙ ключ, не LLM ---
# Картинки/видео/музыка/звуки/голос в Create (кроме Outsee).
# Один KIE_API_KEY, без дубля ниже по файлу — иначе победит последний.
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai

# --- Yandex Object Storage (публичный хост реф-кадров для Outsee) ---
# Бакет: чтение объектов «для всех». Ключи: IAM → сервисный аккаунт → статический ключ.
YANDEX_STORAGE_BUCKET=
YANDEX_STORAGE_ACCESS_KEY=
YANDEX_STORAGE_SECRET_KEY=
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YANDEX_STORAGE_REGION=ru-central1

# --- Kimi K3 / TokenRouter (доп. модель, GPT не заменяет) ---
# Ключ: https://www.tokenrouter.com
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=moonshotai/kimi-k3-free

# --- vibecode.moe (каталог моделей на нодах: GPT 5.5 / 5.6 Sol / Claude / …) ---
# Ключ vk-…  Трафик идёт на VPS (GPT_BASE_URL + GPT_RELAY_TOKEN), не напрямую.
VIBECODE_API_KEY=vk-9EaUvUF1y7JNG-jNIR_z8s1GXEOZFtrz
# VIBECODE_BASE_URL нужен только без VPS (не рекомендуется):
# VIBECODE_BASE_URL=https://vibecode.moe/v1

# === Git / оркестратор (ветка этого ПК) ===
# housepc | tompc | strangepc | workpc | main
ORCHESTRATOR_GIT_BRANCH=housepc

# === 11Labs ===
ELEVENLABS_WEB_URL=https://elevenlabs.io/app/speech-synthesis

# === MoreLogin / публикация ===
MORELOGIN_PROFILE_ID=
SOCIAL_PUBLISH_ENABLED=false

# === Пути для хранения артефактов (картинки, видео, аудио, финалки) ===
# Paths
DATA_DIR=./data
# Явный шаблон project.xlsx (иначе берётся самый свежий templates/project_template_v8*.xlsx)
# PROJECT_XLSX_TEMPLATE=./templates/project_template_v8.xlsx

# === Whisper (faster-whisper) ===
# tiny | base | small | medium | large-v3
# medium — хороший компромисс скорости/качества на CPU
WHISPER_MODEL=medium
# Windows: без symlink в HF cache (WinError 1314)
HF_HUB_DISABLE_SYMLINKS=1
# Не гонять Whisper второй раз на шаге «Сборка»
SUBTITLE_REWHISPER_ON_ASSEMBLE=false

# === ASR (озвучка / субтитры / монтаж) ===
# whisper = легкий и быстрый (по умолчанию); nvidia = NeMo Parakeet (~2.5 ГБ модель)
ASR_BACKEND=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# === Логика ===
LOG_LEVEL=INFO
# true — авто-продвижение HITL даже без project.auto_mode
HITL_AUTO_APPROVE=false
# Сколько проектов gen_queue выполнять одновременно (1 = строго по одному).
# Chrome больше нет — можно 2–3 при API-only.
WORKER_MAX_PARALLEL=1

# === Web UI (FastAPI + Next.js) ===
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8765
