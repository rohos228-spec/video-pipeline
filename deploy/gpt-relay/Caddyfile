# DOMAIN — публичный хост (DNS A → IP VPS). TLS через Let's Encrypt.
{$DOMAIN:localhost} {
	# health без upstream
	@health path /__relay_health
	respond @health "ok\n" 200

	# без токена — отказ (RELAY_TOKEN задай в .env / compose)
	@noauth not header X-VP-Relay-Token {$RELAY_TOKEN}
	respond @noauth "unauthorized\n" 401

	# vibecode.moe — OpenAI /v1/chat/completions (GPT 5.5 / 5.6 Sol)
	handle /v1/* {
		reverse_proxy https://vibecode.moe {
			header_up Host vibecode.moe
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
			transport http {
				versions 1.1
				read_timeout 0
				write_timeout 0
				dial_timeout 30s
			}
		}
	}

	# kie.ai — /codex/v1/responses и jobs retrieve
	handle {
		reverse_proxy https://api.kie.ai {
			header_up Host api.kie.ai
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
			transport http {
				versions 1.1
				read_timeout 0
				write_timeout 0
				dial_timeout 30s
			}
		}
	}
}
