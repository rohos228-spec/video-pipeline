{
  "version": "2",
  "check_first": true,
  "forbidden": [
    {
      "id": "sound",
      "hint": "в кадре есть звук",
      "patterns": [
        "(?<![а-яёa-z])звук",
        "(?<![а-яёa-z])слыш",
        "(?<![а-яёa-z])шум",
        "(?<![а-яёa-z])музык",
        "(?<![а-яёa-z])голос",
        "(?<![а-яёa-z])эхо",
        "(?<![а-яёa-z])грохот",
        "(?<![а-яёa-z])громок",
        "(?<![а-яёa-z])громк",
        "(?<![а-яёa-z])шепот",
        "(?<![а-яёa-z])тишин",
        "(?<![а-яёa-z])звон",
        "(?<![а-яёa-z])скрип",
        "(?<![a-z])sound(?![a-z])",
        "(?<![a-z])noise(?![a-z])"
      ],
      "examples": [
        "Герой слышит громкий удар по двери"
      ]
    },
    {
      "id": "smell",
      "hint": "в кадре есть запах",
      "patterns": [
        "(?<![а-яёa-z])запах",
        "(?<![а-яёa-z])пахн",
        "(?<![а-яёa-z])аромат",
        "(?<![а-яёa-z])вонь",
        "(?<![а-яёa-z])воня",
        "(?<![a-z])smell(?![a-z])",
        "(?<![a-z])scent(?![a-z])"
      ],
      "examples": [
        "В комнате стоит запах гари"
      ]
    },
    {
      "id": "thought",
      "hint": "в кадре есть мысль",
      "patterns": [
        "(?<![а-яёa-z])думает",
        "(?<![а-яёa-z])подумал",
        "(?<![а-яёa-z])мысл",
        "(?<![а-яёa-z])вспомина",
        "(?<![а-яёa-z])понимает",
        "(?<![а-яёa-z])осозна",
        "(?<![а-яёa-z])чувствует",
        "в голове",
        "про себя",
        "(?<![а-яёa-z])надеется",
        "(?<![а-яёa-z])боится",
        "(?<![a-z])thinks(?![a-z])",
        "(?<![a-z])thought(?![a-z])"
      ],
      "examples": [
        "Герой думает, что пол опасен"
      ]
    },
    {
      "id": "time",
      "hint": "в кадре абстрактное время",
      "patterns": [
        "время останав",
        "время замир",
        "(?<![а-яёa-z])вечность",
        "в прошлом",
        "петл\\w* времени",
        "flashback",
        "time stops"
      ],
      "examples": [
        "Время останавливается вокруг героя"
      ]
    },
    {
      "id": "invisible",
      "hint": "в кадре невидимое",
      "patterns": [
        "невидим",
        "(?<![а-яёa-z])аура",
        "(?<![а-яёa-z])душа",
        "телепат",
        "(?<![a-z])invisible(?![a-z])",
        "(?<![a-z])aura(?![a-z])"
      ],
      "examples": [
        "Невидимая сила толкает героя к стене"
      ]
    },
    {
      "id": "words",
      "hint": "кадр держится на надписи",
      "patterns": [
        "(?<![а-яёa-z])надпись",
        "(?<![а-яёa-z])титры",
        "(?<![а-яёa-z])субтитр",
        "(?<![а-яёa-z])буквы",
        "текст на",
        "слова на экране"
      ],
      "examples": [
        "На стене горит надпись с правилом"
      ]
    },
    {
      "id": "crowded",
      "hint": "в кадре толпа или десятки объектов",
      "patterns": [
        "(?<![а-яёa-z])толп",
        "(?<![а-яёa-z])десятк",
        "(?<![а-яёa-z])сотн",
        "(?<![а-яёa-z])множество",
        "(?<![а-яёa-z])орда",
        "(?<![а-яёa-z])дюжин",
        "(?<![a-z])crowd(?![a-z])",
        "(?<![a-z])dozens(?![a-z])"
      ],
      "examples": [
        "Десятки людей заполняют комнату"
      ]
    }
  ],
  "action_rule": "В действии кадра есть глагол в форме настоящего времени (идёт, падает, хватает, раскрывается) и нет невидимых глаголов.",
