# PowerShell & Batch files on Windows: CRLF checkout on every OS.
# UTF-8 BOM stays in .ps1 files (required for Cyrillic in PowerShell 5.1).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.schema.json eol=lf

# N-этапный JSON датасетов B: git должен видеть их точные байты при checkout.
evals/orchestrator/datasets/*.json -text
