*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
web/.next/
# web/out коммитим на ПК-ветках: git pull обновляет UI без npm (см. web/.gitignore)

# Virtualenvs
.venv/
venv/
env/

# Env & secrets
.env
.env.local
.env.bak
.env.bak-*
Data_video_pipeline.env
STUDIO-LOCAL.cmd
*.pem

# MCP / local tools
.ai-orchestra-mcp/node_modules/

# IDE
.idea/
.vscode/
*.swp

# Data (артефакты проектов — не коммитим в git)
data/
browser_profile/

# OS
.DS_Store
Thumbs.db

# Logs (только корневая папка; не web/src/components/logs)
*.log
/logs/

# Локальная история версий промтов (не коммитим)
prompts/**/.history/

# Все промты — только локально (не тянуть с GitHub при install/update)
prompts/*
!prompts/.gitkeep
# Промпты scene_design — часть кода ноды, без них load_prompt падает: держим в git
!prompts/scene_design/
# 05_excel_gpt / enrich_* — локальные загрузки оператора, не библиотека в git
!prompts/03_razbivka/
!prompts/03_razbivka/default.md
