diff --git a/app/node_packages/loader.py b/app/node_packages/loader.py
new file mode 100644
index 0000000..d75d486
--- /dev/null
+++ b/app/node_packages/loader.py
@@ -0,0 +1,226 @@
+"""Скан каталога пакетов нод, реестр и выдача данных для каталога/диспетчера."""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from loguru import logger
+
+from app.node_packages.manifest import (
+    NODE_API_VERSION,
+    LoadedPackage,
+    ManifestError,
+    NodeCapabilityData,
+    find_manifest_file,
+    read_manifest,
+)
+
+PACKAGES_DIR_ENV = "NODE_PACKAGES_DIR"
+PACKAGE_NODE_DATA_KEY = "packageNode"
+CARRIER_NODE_TYPE = "excel_gpt"
+PACKAGE_NODE_KIND = "package"
+
+
+def default_packages_root() -> Path:
+    return Path(__file__).resolve().parents[2] / "node_packages"
+
+
+def packages_root() -> Path:
+    raw = os.environ.get(PACKAGES_DIR_ENV, "").strip()
+    return Path(raw) if raw else default_packages_root()
+
+
+def _reserved_type_error(node_id: str) -> str | None:
+    from app.orchestrator.node_registry import (
+        CONFIG_NODE_TYPES,
+        HITL_NODE_TYPES,
+        SIDE_NODE_TYPES,
+        WORK_NODES,
+        is_hitl_node_type,
+    )
+    from app.services.excel_gpt_node import is_excel_gpt_node_type
+
+    builtin = set(WORK_NODES) | set(HITL_NODE_TYPES) | set(CONFIG_NODE_TYPES) | set(SIDE_NODE_TYPES)
+    if node_id in builtin or is_hitl_node_type(node_id) or is_excel_gpt_node_type(node_id):
+        return f"id {node_id!r} совпадает со встроенным типом ноды"
+    return None
+
+
+@dataclass(frozen=True)
+class PackageError:
+    directory: str
+    message: str
+
+    def to_dict(self) -> dict[str, str]:
+        return {"directory": self.directory, "error": self.message}
+
+
+@dataclass
+class PackageRegistry:
+    root: Path
+    packages: dict[str, LoadedPackage] = field(default_factory=dict)
+    errors: list[PackageError] = field(default_factory=list)
+
+
+def _load_prompts(pkg_dir: Path, rel_paths: dict[str, str]) -> dict[str, str]:
+    base = pkg_dir.resolve()
+    out: dict[str, str] = {}
+    for slot, rel in rel_paths.items():
+        path = (pkg_dir / rel).resolve()
+        if not path.is_relative_to(base):
+            raise ManifestError(f"prompts.{slot}: путь {rel!r} выходит за пределы пакета")
+        if not path.is_file():
+            raise ManifestError(f"prompts.{slot}: файл {rel!r} не найден")
+        text = path.read_text(encoding="utf-8")
+        if not text.strip():
+            raise ManifestError(f"prompts.{slot}: файл {rel!r} пуст")
+        out[slot] = text
+    return out
+
+
+def _load_one(pkg_dir: Path) -> LoadedPackage:
+    manifest_file = find_manifest_file(pkg_dir)
+    if manifest_file is None:
+        raise ManifestError("нет node.yaml / node.json")
+    manifest = read_manifest(manifest_file)
+    reserved = _reserved_type_error(manifest.id)
+    if reserved:
+        raise ManifestError(reserved)
+    if str(manifest.defaults.get("transport") or "api").lower() != "api":
+        raise ManifestError("defaults.transport: допустим только api")
+    prompts = _load_prompts(pkg_dir, manifest.prompts)
+    return LoadedPackage(manifest=manifest, root=pkg_dir, prompts=prompts)
+
+
+def scan(root: Path) -> PackageRegistry:
+    reg = PackageRegistry(root=root)
+    if not root.is_dir():
+        return reg
+    for pkg_dir in sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith((".", "_"))):
+        try:
+            pkg = _load_one(pkg_dir)
+            if pkg.id in reg.packages:
+                other = reg.packages[pkg.id].root.name
+                raise ManifestError(f"id {pkg.id!r} уже занят пакетом {other!r}")
+        except ManifestError as e:
+            reg.errors.append(PackageError(pkg_dir.name, str(e)))
+            logger.warning("node_packages: пакет {} пропущен: {}", pkg_dir.name, e)
+            continue
+        except Exception as e:  # noqa: BLE001 — старт не должен падать из-за чужого пакета
+            reg.errors.append(PackageError(pkg_dir.name, f"{type(e).__name__}: {e}"))
+            logger.warning("node_packages: пакет {} пропущен: {}", pkg_dir.name, e, exc_info=True)
+            continue
+        reg.packages[pkg.id] = pkg
+    return reg
+
+
+_registry: PackageRegistry | None = None
+
+
+def reload(root: Path | None = None) -> PackageRegistry:
+    global _registry
+    _registry = scan(root if root is not None else packages_root())
+    return _registry
+
+
+def get_registry() -> PackageRegistry:
+    return _registry if _registry is not None else reload()
+
+
+def package_ids() -> frozenset[str]:
+    return frozenset(get_registry().packages)
+
+
+def get_package(package_id: str | None) -> LoadedPackage | None:
+    return get_registry().packages.get(str(package_id or ""))
+
+
+def package_id_of_node(node: dict[str, Any] | None) -> str | None:
+    data = (node or {}).get("data")
+    if not isinstance(data, dict):
+        return None
+    raw = str(data.get(PACKAGE_NODE_DATA_KEY) or "").strip()
+    return raw if raw in get_registry().packages else None
+
+
+def is_package_node(node: dict[str, Any] | None) -> bool:
+    return package_id_of_node(node) is not None
+
+
+def capability_for(package_id: str) -> NodeCapabilityData | None:
+    pkg = get_package(package_id)
+    return pkg.manifest.capability() if pkg else None
+
+
+def canvas_node_template(pkg: LoadedPackage) -> dict[str, Any]:
+    m = pkg.manifest
+    defaults = dict(m.defaults)
+    config: dict[str, Any] = {"excelGpt": defaults}
+    model_id = str(defaults.pop("modelId", "") or "").strip()
+    if model_id:
+        config["modelId"] = model_id
+    return {
+        "type": CARRIER_NODE_TYPE,
+        "data": {
+            "label": m.title,
+            "slotOverflow": True,
+            PACKAGE_NODE_DATA_KEY: m.id,
+            "packageVersion": m.version,
+            "config": config,
+        },
+    }
+
+
+def catalog_entry(pkg: LoadedPackage) -> dict[str, Any]:
+    m = pkg.manifest
+    return {
+        "type": m.id,
+        "label": m.title,
+        "kind": PACKAGE_NODE_KIND,
+        "source": "package",
+        "version": m.version,
+        "nodeapi": m.nodeapi,
+        "description": m.description,
+        "step_code": CARRIER_NODE_TYPE,
+        "has_prompt": True,
+        "runtime": m.runtime.model_dump(),
+        "ui": m.ui.model_dump(),
+        "ports": m.ports.model_dump(),
+        "defaults": dict(m.defaults),
+        "orchestrator": m.capability().to_dict(),
+        "canvas_node": canvas_node_template(pkg),
+    }
+
+
+def catalog_nodes() -> list[dict[str, Any]]:
+    return [catalog_entry(p) for p in get_registry().packages.values() if p.manifest.ui.palette]
+
+
+def load_errors() -> list[dict[str, str]]:
+    return [e.to_dict() for e in get_registry().errors]
+
+
+def status() -> dict[str, Any]:
+    reg = get_registry()
+    return {
+        "nodeapi": NODE_API_VERSION,
+        "root": str(reg.root),
+        "loaded": [
+            {"id": p.id, "version": p.manifest.version, "directory": p.root.name}
+            for p in reg.packages.values()
+        ],
+        "errors": load_errors(),
+    }
+
+
+def prompt_for_node(meta: dict[str, Any] | None, node_key: str | None) -> tuple[str, Path, str] | None:
+    """(имя, путь, текст) главного промта пакета для ноды канваса, иначе None."""
+    from app.services.node_config import find_node
+
+    pkg = get_package(package_id_of_node(find_node(meta, node_key)))
+    if pkg is None:
+        return None
+    return f"pkg:{pkg.id}", pkg.prompt_path("main"), pkg.prompts["main"]
diff --git a/app/node_packages/manifest.py b/app/node_packages/manifest.py
new file mode 100644
index 0000000..5c39057
--- /dev/null
+++ b/app/node_packages/manifest.py
@@ -0,0 +1,278 @@
+"""Схема манифеста пакета ноды (NodeAPI 1) и разбор node.yaml / node.json."""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+from typing import Any, Literal
+
+import yaml
+from pydantic import BaseModel, ConfigDict, Field, ValidationError, field_validator
+
+NODE_API_VERSION = 1
+SUPPORTED_NODE_API: frozenset[int] = frozenset({NODE_API_VERSION})
+MANIFEST_FILENAMES: tuple[str, ...] = ("node.yaml", "node.yml", "node.json")
+
+RESULT_KINDS = frozenset(
+    {"project_text", "frame_set", "frame_prompts", "structured", "image", "video", "audio", "assembly"}
+)
+PHASES = frozenset(
+    {"running", "parse", "validate", "apply", "commit", "verify", "human_approval", "generating", "writing"}
+)
+EFFECTS = frozenset(
+    {"project_database", "local_xlsx", "local_file", "local_checkpoint", "artifact_row", "hitl_request"}
+)
+ACTIONS = frozenset(
+    {"read_events", "read_contract", "wait", "human_review", "retry_same", "retry_profile", "finish"}
+)
+RECOVERY_CONTINUATIONS = frozenset({"excel_gpt_chain", "none"})
+PORT_TYPES = frozenset({"text", "table", "image", "video", "audio", "json", "any"})
+_ID_RE = re.compile(r"^[a-z][a-z0-9_]{2,47}$")
+_SEMVER_RE = re.compile(r"^\d+\.\d+\.\d+$")
+
+
+class ManifestError(ValueError):
+    """Манифест не прошёл проверку; текст — для человека, который правит файл."""
+
+
+@dataclass(frozen=True)
+class NodeCapabilityData:
+    """Данные capability узла 1:1 с блоком `orchestrator:` манифеста.
+
+    Только структура: оркестраторного слоя в этом дереве нет.
+    """
+
+    node_type: str
+    result_kind: str = "structured"
+    executor: str = "enrich_xlsx.run"
+    phases: tuple[str, ...] = ("running", "parse", "validate", "apply", "commit")
+    effects: tuple[str, ...] = ("project_database",)
+    actions: tuple[str, ...] = ("read_events", "read_contract", "wait", "human_review")
+    managed: bool = False
+    approval: tuple[str, ...] = ("scope", "budget", "provider_profile")
+    profile_compatible: bool = False
+    volatile_attachment_names: bool = False
+    native_json_retry: bool = True
+    recovery_continuation: str = "excel_gpt_chain"
+
+    def to_dict(self) -> dict[str, Any]:
+        out = asdict(self)
+        for key in ("phases", "effects", "actions", "approval"):
+            out[key] = list(out[key])
+        return out
+
+    @classmethod
+    def from_dict(cls, raw: dict[str, Any]) -> NodeCapabilityData:
+        data = dict(raw)
+        for key in ("phases", "effects", "actions", "approval"):
+            if key in data:
+                data[key] = tuple(data[key])
+        return cls(**data)
+
+
+class _Strict(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+
+class RuntimeBlock(_Strict):
+    kind: Literal["llm"] = "llm"
+    channel: Literal["excel_gpt_overflow"] = "excel_gpt_overflow"
+    transport: Literal["api"] = "api"
+
+
+class UiBlock(_Strict):
+    category: str = "planning"
+    icon: str = "sparkles"
+    accent: str | None = None
+    palette: bool = True
+
+
+class PortSpec(_Strict):
+    name: str = Field(min_length=1, max_length=64)
+    type: str = "any"
+    required: bool = False
+    description: str = ""
+
+    @field_validator("type")
+    @classmethod
+    def _known_type(cls, v: str) -> str:
+        if v not in PORT_TYPES:
+            raise ValueError(f"неизвестный тип порта {v!r}, допустимы: {sorted(PORT_TYPES)}")
+        return v
+
+
+class PortsBlock(_Strict):
+    inputs: list[PortSpec] = Field(default_factory=list)
+    outputs: list[PortSpec] = Field(default_factory=list)
+
+    @field_validator("inputs", "outputs")
+    @classmethod
+    def _unique_names(cls, v: list[PortSpec]) -> list[PortSpec]:
+        names = [p.name for p in v]
+        dup = sorted({n for n in names if names.count(n) > 1})
+        if dup:
+            raise ValueError(f"повторяющиеся имена портов: {dup}")
+        return v
+
+
+def _one_of(label: str, allowed: frozenset[str], values: list[str]) -> list[str]:
+    bad = sorted(set(values) - allowed)
+    if bad:
+        raise ValueError(f"неизвестные {label} {bad}, допустимы: {sorted(allowed)}")
+    return values
+
+
+class OrchestratorBlock(_Strict):
+    result_kind: str = "structured"
+    executor: str = "enrich_xlsx.run"
+    phases: list[str] = Field(default_factory=lambda: ["running", "parse", "validate", "apply", "commit"])
+    effects: list[str] = Field(default_factory=lambda: ["project_database"])
+    actions: list[str] = Field(
+        default_factory=lambda: ["read_events", "read_contract", "wait", "human_review"]
+    )
+    managed: bool = False
+    acceptance: str | None = None
+    approval: list[str] = Field(default_factory=lambda: ["scope", "budget", "provider_profile"])
+    profile_compatible: bool = False
+    volatile_attachment_names: bool = False
+    native_json_retry: bool = True
+    recovery_continuation: str = "excel_gpt_chain"
+
+    @field_validator("result_kind")
+    @classmethod
+    def _result_kind(cls, v: str) -> str:
+        if v not in RESULT_KINDS:
+            raise ValueError(f"result_kind {v!r} вне {sorted(RESULT_KINDS)}")
+        return v
+
+    @field_validator("phases")
+    @classmethod
+    def _phases(cls, v: list[str]) -> list[str]:
+        return _one_of("phases", PHASES, v)
+
+    @field_validator("effects")
+    @classmethod
+    def _effects(cls, v: list[str]) -> list[str]:
+        return _one_of("effects", EFFECTS, v)
+
+    @field_validator("actions")
+    @classmethod
+    def _actions(cls, v: list[str]) -> list[str]:
+        return _one_of("actions", ACTIONS, v)
+
+    @field_validator("recovery_continuation")
+    @classmethod
+    def _recovery(cls, v: str) -> str:
+        if v not in RECOVERY_CONTINUATIONS:
+            raise ValueError(f"recovery_continuation {v!r} вне {sorted(RECOVERY_CONTINUATIONS)}")
+        return v
+
+
+class NodeManifest(_Strict):
+    nodeapi: int
+    id: str
+    version: str
+    title: str = Field(min_length=1, max_length=80)
+    description: str = ""
+    runtime: RuntimeBlock = Field(default_factory=RuntimeBlock)
+    ui: UiBlock = Field(default_factory=UiBlock)
+    ports: PortsBlock = Field(default_factory=PortsBlock)
+    prompts: dict[str, str]
+    defaults: dict[str, Any] = Field(default_factory=dict)
+    orchestrator: OrchestratorBlock = Field(default_factory=OrchestratorBlock)
+
+    @field_validator("id")
+    @classmethod
+    def _id(cls, v: str) -> str:
+        if not _ID_RE.match(v):
+            raise ValueError("id: строчные латинские буквы, цифры и _, 3..48 символов, первая — буква")
+        return v
+
+    @field_validator("version")
+    @classmethod
+    def _version(cls, v: str) -> str:
+        if not _SEMVER_RE.match(v):
+            raise ValueError("version: ожидается MAJOR.MINOR.PATCH")
+        return v
+
+    @field_validator("prompts")
+    @classmethod
+    def _prompts(cls, v: dict[str, str]) -> dict[str, str]:
+        if "main" not in v:
+            raise ValueError("prompts.main обязателен")
+        return v
+
+    def capability(self) -> NodeCapabilityData:
+        o = self.orchestrator
+        return NodeCapabilityData(
+            node_type=self.id,
+            result_kind=o.result_kind,
+            executor=o.executor,
+            phases=tuple(o.phases),
+            effects=tuple(o.effects),
+            actions=tuple(o.actions),
+            managed=bool(o.managed and o.acceptance),
+            approval=tuple(o.approval),
+            profile_compatible=o.profile_compatible,
+            volatile_attachment_names=o.volatile_attachment_names,
+            native_json_retry=o.native_json_retry,
+            recovery_continuation=o.recovery_continuation,
+        )
+
+
+@dataclass(frozen=True)
+class LoadedPackage:
+    manifest: NodeManifest
+    root: Path
+    prompts: dict[str, str] = field(default_factory=dict)
+
+    @property
+    def id(self) -> str:
+        return self.manifest.id
+
+    def prompt_path(self, slot: str = "main") -> Path:
+        return self.root / self.manifest.prompts[slot]
+
+
+def find_manifest_file(pkg_dir: Path) -> Path | None:
+    for name in MANIFEST_FILENAMES:
+        candidate = pkg_dir / name
+        if candidate.is_file():
+            return candidate
+    return None
+
+
+def _format_validation_error(exc: ValidationError) -> str:
+    parts = []
+    for err in exc.errors():
+        loc = ".".join(str(p) for p in err["loc"]) or "<root>"
+        msg = str(err["msg"]).removeprefix("Value error, ")
+        parts.append(f"{loc}: {msg}")
+    return "; ".join(parts)
+
+
+def read_manifest(path: Path) -> NodeManifest:
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as e:
+        raise ManifestError(f"{path.name}: не читается ({e})") from e
+    try:
+        raw = json.loads(text) if path.suffix == ".json" else yaml.safe_load(text)
+    except (yaml.YAMLError, json.JSONDecodeError) as e:
+        raise ManifestError(f"{path.name}: синтаксическая ошибка ({e})") from e
+    if not isinstance(raw, dict):
+        raise ManifestError(f"{path.name}: корень манифеста должен быть словарём")
+    version = raw.get("nodeapi")
+    if not isinstance(version, int) or isinstance(version, bool):
+        raise ManifestError(f"{path.name}: nodeapi обязателен и должен быть целым числом")
+    if version not in SUPPORTED_NODE_API:
+        raise ManifestError(
+            f"{path.name}: nodeapi={version} не поддерживается ядром "
+            f"(поддерживается {sorted(SUPPORTED_NODE_API)})"
