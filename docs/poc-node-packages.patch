@@ -0,0 +1,431 @@
+"""Пакеты нод: папка с манифестом добавляет ноду без правок ядра.
+
+Доказывается по частям: загрузчик и валидация, видимость в реестре и в
+`/workflows/catalog`, второй пакет из отдельного каталога (`NODE_PACKAGES_DIR`),
+отказ по версии NodeAPI, данные capability и диспетч через канал excel_gpt
+с промтом из манифеста.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import uuid
+from contextlib import asynccontextmanager
+from pathlib import Path
+
+import pytest
+import yaml
+from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine
+
+from app import node_packages
+from app.models import Base, Project, ProjectStatus, Workflow
+from app.node_packages import NodeCapabilityData
+from app.node_packages.loader import default_packages_root
+from app.orchestrator.node_registry import (
+    CONFIG_NODE_TYPES,
+    HITL_NODE_TYPES,
+    WORK_NODES,
+    is_package_node_type,
+    spec_for_node,
+)
+from app.web.routers.workflows import node_catalog
+
+SAMPLE_IDS = {"sample_llm_summary", "sample_llm_checklist"}
+
+
+def _catalog() -> dict:
+    return asyncio.run(node_catalog())
+
+
+def _write_package(root: Path, name: str, manifest: dict, prompt: str | None = "Промт пакета.\n") -> Path:
+    pkg = root / name
+    pkg.mkdir(parents=True)
+    (pkg / "node.yaml").write_text(yaml.safe_dump(manifest, allow_unicode=True), encoding="utf-8")
+    if prompt is not None:
+        (pkg / "prompt.md").write_text(prompt, encoding="utf-8")
+    return pkg
+
+
+def _manifest(node_id: str, **over) -> dict:
+    base = {
+        "nodeapi": 1,
+        "id": node_id,
+        "version": "1.0.0",
+        "title": f"Пакет {node_id}",
+        "prompts": {"main": "prompt.md"},
+        "ports": {"inputs": [{"name": "src", "type": "text"}], "outputs": [{"name": "out", "type": "text"}]},
+        "defaults": {"role": "assist", "outputMode": "text"},
+    }
+    base.update(over)
+    return base
+
+
+@pytest.fixture(autouse=True)
+def _restore_registry(monkeypatch):
+    monkeypatch.delenv(node_packages.PACKAGES_DIR_ENV, raising=False)
+    node_packages.reload()
+    yield
+    monkeypatch.undo()
+    node_packages.reload()
+
+
+@pytest.fixture
+def packages_dir(tmp_path, monkeypatch) -> Path:
+    root = tmp_path / "pkgs"
+    root.mkdir()
+    monkeypatch.setenv(node_packages.PACKAGES_DIR_ENV, str(root))
+    return root
+
+
+def test_bundled_samples_load_without_errors() -> None:
+    reg = node_packages.reload(default_packages_root())
+    assert set(reg.packages) == SAMPLE_IDS
+    assert reg.errors == []
+    yaml_pkg = reg.packages["sample_llm_summary"]
+    json_pkg = reg.packages["sample_llm_checklist"]
+    assert yaml_pkg.manifest.title and "{{TOPIC}}" in yaml_pkg.prompts["main"]
+    assert json_pkg.manifest.defaults["modelId"] == "gpt-5.6-sol"
+
+
+def test_package_visible_in_registry_and_catalog() -> None:
+    assert is_package_node_type("sample_llm_summary")
+    assert not is_package_node_type("images")
+
+    cat = _catalog()
+    by_type = {n["type"]: n for n in cat["package_nodes"]}
+    assert set(by_type) == SAMPLE_IDS
+    entry = by_type["sample_llm_summary"]
+    assert entry["label"] == "Краткое содержание (пример)"
+    assert entry["source"] == "package" and entry["version"] == "1.0.0"
+    assert [p["name"] for p in entry["ports"]["inputs"]] == ["source_text"]
+    assert [p["name"] for p in entry["ports"]["outputs"]] == ["summary"]
+    assert entry["defaults"]["role"] == "assist"
+    assert entry["canvas_node"]["type"] == "excel_gpt"
+    assert entry["canvas_node"]["data"]["packageNode"] == "sample_llm_summary"
+    assert entry["canvas_node"]["data"]["slotOverflow"] is True
+    assert by_type["sample_llm_checklist"]["canvas_node"]["data"]["config"]["modelId"] == "gpt-5.6-sol"
+    assert cat["package_errors"] == []
+
+    builtin = {n["type"] for n in cat["nodes"]}
+    assert builtin == set(WORK_NODES) | set(HITL_NODE_TYPES) | set(CONFIG_NODE_TYPES)
+
+
+def test_canvas_node_resolves_to_excel_gpt_overflow_statuses() -> None:
+    node = {"id": "n1", **node_packages.canvas_node_template(node_packages.get_package("sample_llm_summary"))}
+    spec = spec_for_node(node)
+    assert spec is not None
+    assert spec.node_type == "excel_gpt"
+    assert spec.running_status is ProjectStatus.enriching_1
+    assert spec.ready_status is ProjectStatus.enrich_1_ready
+
+
+def test_plain_overflow_node_is_unchanged() -> None:
+    from app.services.excel_gpt_node import slot_index_from_node, status_slot_for_node
+
+    plain = {"id": "chk", "type": "excel_gpt", "data": {"slotOverflow": True}}
+    assert slot_index_from_node(plain) == 0
+    assert status_slot_for_node(plain) == 0
+    unknown_pkg = {"id": "x", "type": "excel_gpt", "data": {"slotOverflow": True, "packageNode": "nope"}}
+    assert status_slot_for_node(unknown_pkg) == 0
+
+
+def test_invalid_manifests_are_skipped_with_error_entries(packages_dir: Path) -> None:
+    _write_package(packages_dir, "good", _manifest("good_node"))
+    _write_package(packages_dir, "no_title", {k: v for k, v in _manifest("no_title").items() if k != "title"})
+    _write_package(packages_dir, "bad_id", _manifest("Bad-Id"))
+    _write_package(packages_dir, "typo_key", _manifest("typo_key", portz=[]))
+    _write_package(
+        packages_dir, "bad_port", _manifest("bad_port", ports={"inputs": [{"name": "a", "type": "zzz"}]})
+    )
+    _write_package(packages_dir, "no_prompt_file", _manifest("no_prompt_file"), prompt=None)
+    _write_package(packages_dir, "escape", _manifest("escape", prompts={"main": "../outside.md"}))
+    _write_package(packages_dir, "builtin_id", _manifest("images"))
+    _write_package(packages_dir, "enrich_id", _manifest("enrich_9"))
+    _write_package(packages_dir, "browser", _manifest("browser_node", defaults={"transport": "browser"}))
+    _write_package(packages_dir, "bad_orch", _manifest("bad_orch", orchestrator={"effects": ["format_disk"]}))
+    _write_package(packages_dir, "code_kind", _manifest("code_kind", runtime={"kind": "code"}))
+    broken = packages_dir / "broken_yaml"
+    broken.mkdir()
+    (broken / "node.yaml").write_text("id: [unclosed\n", encoding="utf-8")
+    (packages_dir / "empty_dir").mkdir()
+    (packages_dir / "stray.txt").write_text("not a package", encoding="utf-8")
+
+    reg = node_packages.reload()
+
+    assert set(reg.packages) == {"good_node"}
+    errors = {e.directory: e.message for e in reg.errors}
+    assert set(errors) == {
+        "no_title",
+        "bad_id",
+        "typo_key",
+        "bad_port",
+        "no_prompt_file",
+        "escape",
+        "builtin_id",
+        "enrich_id",
+        "browser",
+        "bad_orch",
+        "code_kind",
+        "broken_yaml",
+        "empty_dir",
+    }
+    assert "title" in errors["no_title"]
+    assert "id" in errors["bad_id"]
+    assert "portz" in errors["typo_key"]
+    assert "zzz" in errors["bad_port"]
+    assert "prompt.md" in errors["no_prompt_file"]
+    assert "за пределы" in errors["escape"]
+    assert "встроенным" in errors["builtin_id"] and "встроенным" in errors["enrich_id"]
+    assert "transport" in errors["browser"]
+    assert "format_disk" in errors["bad_orch"]
+    assert "runtime.kind" in errors["code_kind"]
+    assert "синтаксическая" in errors["broken_yaml"]
+    assert "нет node.yaml" in errors["empty_dir"]
+
+    cat = _catalog()
+    assert [n["type"] for n in cat["package_nodes"]] == ["good_node"]
+    assert {e["directory"] for e in cat["package_errors"]} == set(errors)
+
+
+def test_duplicate_id_second_package_is_rejected(packages_dir: Path) -> None:
+    _write_package(packages_dir, "a_first", _manifest("same_id"))
+    _write_package(packages_dir, "b_second", _manifest("same_id"))
