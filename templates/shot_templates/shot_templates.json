  "rules_ai": [
    {
      "тема": "axis",
      "значение": "нет",
      "как понять": "Не проверять стороны персонажей. Подходит для одного человека, пути, монтажа мест.",
      "команда_для_ии": "Ничего не делать с сторонами."
    },
    {
      "тема": "axis",
      "значение": "keep_sides",
      "как понять": "В сцене двое. В первом кадре где оба видны, зафиксируй: кто слева кадра, кто справа. Во всех следующих кадрах этой сцены эти стороны НЕ менять.",
      "команда_для_ии": "ЗАПРЕЩЕНО: в одном кадре {A} смотрит вправо, а в следующем кадре той же сцены {A} смотрит влево без смены места. ЗАПРЕЩЕНО: поставить камеру так, будто герои поменялись местами."
    },
    {
      "тема": "axis",
      "значение": "look_chain",
      "как понять": "Сначала кадр того кто смотрит, потом кадр того НА ЧТО он смотрит, потом кадр реакции ТОГО ЖЕ человека.",
      "команда_для_ии": "ЗАПРЕЩЕНО: реакция другого человека вместо смотрящего. ЗАПРЕЩЕНО: прыжок лицо→лицо без кадра объекта взгляда, если смысл именно во взгляде."
    },
    {
      "тема": "parent",
      "значение": "null",
      "как понять": "Кадр самостоятельный. Новое место или новая сторона диалога или новый объект.",
      "команда_для_ии": "В выходном JSON parent_id = null."
    },
    {
      "тема": "parent",
      "значение": "master",
      "как понять": "Кадр продолжает первое место этой схемы. Parent = shot_id первого кадра этой локации в ячейке.",
      "команда_для_ии": "В выходном JSON parent_id = id master-кадра места."
    },
    {
      "тема": "parent",
      "значение": "side_of_face",
      "как понять": "Крупный лица продолжает сторону того же человека (его предыдущий средний/плечо).",
      "команда_для_ии": "parent_id = shot_id последнего кадра этого же who в этой сцене."
    },
    {
      "тема": "parent",
      "значение": "prev_location_master",
      "как понять": "Ячейка новая, место то же что в прошлой ячейке.",
      "команда_для_ии": "parent_id = id первого кадра этой локации из предыдущей ячейки. Новый ОБЩИЙ не создавать."
    },
    {
      "тема": "parent",
      "значение": "T4-K1",
      "как понять": "Жёсткая ссылка на конкретный shot_id схемы.",
      "команда_для_ии": "parent_id = id кадра, который получился из T4-K1 после подстановки."
    },
    {
      "тема": "compress",
      "значение": "drop_order",
      "как понять": "Если суммарный закадр слишком короткий для всех кадров — удаляй shot_id из drop_order по порядку.",
      "команда_для_ии": "ОСТАНОВИСЬ, если остались только required=1. Не удаляй required=1. Не удаляй единственный кадр нового места, если when требует новое_место."
    },
    {
      "тема": "slots",
