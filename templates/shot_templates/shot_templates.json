{
  "version": 1,
  "select": [
    {
      "step": 1,
      "if": "двое_говорят",
      "then_template": "T1"
    },
    {
      "step": 2,
      "if": "новое_место_и_находка",
      "then_template": "T2"
    },
    {
      "step": 3,
      "if": "только_смена_места",
      "then_template": "T3"
    },
    {
      "step": 4,
      "if": "смысл_во_взгляде",
      "then_template": "T4"
    },
    {
      "step": 5,
      "if": "руки_работают",
      "then_template": "T5"
    },
    {
      "step": 6,
      "if": "путь_A_в_B",
      "then_template": "T6"
    },
    {
      "step": 7,
      "if": "короткий_удар",
      "then_template": "T7"
    },
    {
      "step": 8,
      "if": "монтаж_мест_времени",
      "then_template": "T8"
    },
    {
      "step": 9,
      "if": "один_быт",
      "then_template": "T9"
    },
    {
      "step": 10,
      "if": "уход_конец",
      "then_template": "T10"
    },
    {
      "step": 99,
      "if": "иначе",
      "then_template": "T0"
    }
  ],
  "templates": [
    {
      "id": "T0",
      "name": "один_кадр",
      "when": "одно_место;одно_действие;нет_диалога;нет_находки",
      "axis": "нет",
      "shots_full": "T0-K1",
      "parent_default": "null"
    },
    {
      "id": "T1",
      "name": "диалог_двое",
      "when": "двое;говорят|спорят|спрашивают;одно_место",
      "axis": "keep_sides",
      "shots_full": "T1-K1;T1-K2;T1-K3;T1-K4;T1-K5",
      "drop_order": "T1-K5;T1-K4;T1-K1",
      "parent_default": "по_кадру"
    },
    {
      "id": "T2",
      "name": "пришёл_нашёл",
      "when": "новое_место;нашёл|взял|прочитал;есть_предмет",
      "axis": "нет",
      "shots_full": "T2-K1;T2-K2;T2-K3;T2-K4",
      "drop_order": "T2-K4;T2-K1",
      "parent_default": "master=K1"
    },
    {
      "id": "T3",
      "name": "новое_место",
      "when": "смена_места;нет_диалога;нет_находки",
      "axis": "нет",
      "shots_full": "T3-K1;T3-K2",
      "drop_order": "T3-K2",
      "parent_default": "master=K1"
    },
    {
      "id": "T4",
      "name": "взгляд",
      "when": "смотрит_на;смысл_во_взгляде",
      "axis": "look_chain",
      "shots_full": "T4-K1;T4-K2;T4-K3",
      "drop_order": "T4-K3;T4-K2",
      "parent_default": "по_кадру"
    },
    {
      "id": "T5",
      "name": "руки_предмет",
      "when": "руки_работают;пишет|моет|режет|считает|листает",
      "axis": "нет",
      "shots_full": "T5-K0;T5-K1;T5-K2;T5-K3",
      "drop_order": "T5-K3;T5-K0;T5-K2",
      "parent_default": "master"
    },
    {
      "id": "T6",
      "name": "путь",
      "when": "идёт|едет;откуда_и_куда",
      "axis": "нет",
      "shots_full": "T6-K1;T6-K2;T6-K3",
      "drop_order": "T6-K2;T6-K1",
      "parent_default": "по_кадру"
    },
    {
      "id": "T7",
      "name": "удар",
      "when": "услышал|понял|получил;короткий_слом;не_хвост_диалога",
      "axis": "нет",
      "shots_full": "T7-K1;T7-K2;T7-K3",
      "drop_order": "T7-K1;T7-K2",
      "parent_default": "по_кадру"
    },
    {
      "id": "T8",
      "name": "монтаж_мест",
      "when": "годы|а_потом|другая_жизнь;несколько_мест",
      "axis": "нет",
      "shots_full": "T8-K1;T8-Kn",
      "parent_default": "все_null"
    },
    {
      "id": "T9",
      "name": "один_в_месте",
      "when": "один;одно_помещение;быт|ожидание;нет_диалога;нет_находки",
      "axis": "нет",
      "shots_full": "T9-K1;T9-K2;T9-K3",
      "drop_order": "T9-K3;T9-K1",
      "parent_default": "master=K1"
    },
    {
      "id": "T10",
      "name": "уход",
      "when": "уходит|сцена_конец|пустое_место",
      "axis": "нет",
      "shots_full": "T10-K1;T10-K2",
      "drop_order": "T10-K1;T10-K2",
      "parent_default": "по_кадру"
    },
    {
      "id": "X1",
      "name": "хвост_то_же_место",
      "when": "следующая_ячейка;место_не_сменилось",
      "axis": "нет",
      "shots_full": "X1-K1",
      "parent_default": "prev_location_master"
    },
    {
      "id": "X2",
      "name": "хвост_смена_места",
      "when": "следующая_ячейка;место_сменилось",
      "axis": "нет",
      "shots_full": "X2-A;X2-B",
      "parent_default": "все_null"
    }
  ],
